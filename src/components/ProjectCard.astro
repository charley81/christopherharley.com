---
import type { Project } from '../data/projects'
export type { Project }
export interface Props {
  project: Project
  index: number
}

const { project, index } = Astro.props
const projectNumber = String(index + 1).padStart(2, '0')
---

<article
  class="group border-b border-border-muted last:border-b-0 py-10 md:py-14 lg:py-16 grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end"
>
  <div class="min-w-0">
    <p
      class="font-label-mono text-label-mono text-text-secondary mb-4 md:mb-6"
      aria-hidden="true"
    >
      {projectNumber}
    </p>
    <h3
      class="font-headline-lg text-[clamp(2.75rem,8vw,6.5rem)] leading-[0.92] tracking-[-0.045em] font-semibold text-text-primary text-balance"
    >
      {project.title}
    </h3>
    <ul class="flex flex-wrap gap-2 mt-7 md:mt-9" aria-label="Technologies">
      {
        project.tags.map((tag) => (
          <li class="px-3 py-1.5 border border-border-muted rounded-full text-text-secondary text-[10px] leading-4 uppercase tracking-[0.08em] font-label-mono">
            {tag}
          </li>
        ))
      }
    </ul>
  </div>

  <a
    href={project.slug}
    class="w-fit inline-flex items-center gap-2 pb-1 border-b border-text-primary font-label-mono text-label-mono uppercase text-text-primary transition-[gap,color,border-color] duration-300 hover:gap-4 hover:text-text-secondary hover:border-text-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-text-primary"
    aria-label={`Read ${project.title} case study`}
  >
    <span>Read case study</span>
    <span
      class="material-symbols-outlined text-[18px] transition-transform duration-300 group-hover:translate-x-1"
      aria-hidden="true">arrow_forward</span
    >
  </a>
</article>
